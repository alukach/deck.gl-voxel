{
  "name": "deck.gl-voxel-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Experimental deck.gl layer for visualizing volumetric data with WebGPU",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "^22.13.0 || >=23.5.0"
  },
  "scripts": {
    "build": "tsc --build",
    "watch": "tsc --build --watch",
    "clean": "tsc --build --clean",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "pnpm lint && pnpm build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "typescript": "7.0.2"
  }
}
